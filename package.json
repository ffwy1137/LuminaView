{
  "name": "luminaview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx,.vue",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "prepare": "simple-git-hooks install"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "echarts": "^5.5.0",
    "pinia": "^2.1.0",
    "pinia-plugin-persistedstate": "^3.2.0",
    "vue": "^3.4.0",
    "vue-echarts": "^6.6.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.5.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^9.0.0",
    "jsdom": "^23.0.0",
    "lint-staged": "^15.0.0",
    "playwright": "^1.40.0",
    "prettier": "^3.0.0",
    "simple-git-hooks": "^2.9.0",
    "typescript": "~5.3.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vite-plugin-mock": "^3.0.0",
    "vitest": "^2.0.0",
    "vue-tsc": "^2.0.0"
  }
}
